[Unit]
Description=Telegram Bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User={{ lxc_ssh_user }}
WorkingDirectory={{ telegrambot_dir }}
EnvironmentFile={{ telegrambot_env_file }}
ExecStart={{ telegrambot_binary }}
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
