server {
  listen 80;
  listen [::]:80;
  server_name matrix.quati.xyz quati.xyz;

  return 301 https://$host$request_uri;
}

server {
  listen 443 ssl;
  listen [::]:443 ssl;
  listen 8448 ssl;
  listen [::]:8448 ssl;
  server_name matrix.quati.xyz quati.xyz;

  ssl_certificate /etc/nginx/certs/matrix.crt;
  ssl_certificate_key /etc/nginx/certs/matrix.key;

  client_max_body_size 50m;

  location = /.well-known/matrix/server {
    default_type application/json;
    return 200 '{"m.server":"matrix.quati.xyz:443"}';
  }

  location = /.well-known/matrix/client {
    default_type application/json;
    add_header Access-Control-Allow-Origin "*" always;
    return 200 '{"m.homeserver":{"base_url":"https://matrix.quati.xyz"}}';
  }

  location / {
    proxy_pass http://192.168.0.19:8008;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 600s;
    proxy_send_timeout 600s;
  }
}
