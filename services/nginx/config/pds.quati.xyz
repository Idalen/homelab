# Cloudflare Tunnel terminates public TLS and connects to this dedicated LAN port.
# Tunnel origin: http://192.168.0.3:8081 (preserve the public Host header).
server {
  listen 192.168.0.3:8081;
  server_name pds.quati.xyz *.pds.quati.xyz;

  client_max_body_size 300m;

  location / {
    proxy_pass http://192.168.0.14:3000;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto https;
    # The tunnel supplies this header. Do not expose this listener publicly.
    proxy_set_header X-Forwarded-For $http_cf_connecting_ip;
    proxy_set_header X-Real-IP $http_cf_connecting_ip;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $pds_connection_upgrade;
    proxy_read_timeout 3600s;
    proxy_send_timeout 3600s;
    proxy_buffering off;
    proxy_request_buffering off;
  }
}

map $http_upgrade $pds_connection_upgrade {
  default upgrade;
  '' close;
}
