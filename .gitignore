.env

# Apps Stuff
qbittorrent/*
homeassistant/*
pihole/*
jellyfin/*

# ------- OpenTofu/Terraform -------- #
# OpenTofu/Terraform working directory
.terraform/
**/.terraform/*

.terraform.lock.hcl

# Terraform state files
*.tfstate
*.tfstate.*

# Crash logs
crash.log
crash.*.log

# OpenTofu/Terraform CLI config (credentials, tokens)
.terraformrc
terraform.rc

# Override files (local-only)
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Variable definitions that may contain secrets
*.tfvars
*.tfvars.json

# packer
*.pkrvars.hcl
